document.querySelectorAll("#nfilter .chip").forEach(b=>b.onclick=()=>{NC=b.dataset.c;document.querySelectorAll("#nfilter .chip").forEach(x=>x.setAttribute("aria-pressed",x===b));renderNews();});

// 日程与日志
const CAL=[["10-08 周三","EIA 原油库存周报","周频"],["10-09 周四","美国初请失业金、美联储资产负债表","周频"],["10-10 周五","CFTC 持仓报告；SCFI 运价","周频"],["10-13 周一","中国 9 月进出口","月频"],["10-14 周二","中国 9 月金融数据（社融、M1、M2、贷款）","月频"],["10-15 周三","美国 9 月 CPI；中国 9 月 CPI、PPI","月频"],["10-16 周四","IEA 月度石油市场报告","新闻"],["10-20 周一","中国三季度 GDP、70 城房价、商品房销售","月频"],["10-21 周二","韩国 10 月前 20 天出口","月频"]];
const CADP={"周频":"cad-w","月频":"cad-m","新闻":"cad-n","日频":"cad-d"};
document.getElementById("cal").innerHTML=CAL.map(c=>`<div class="li"><span class="num" style="color:var(--muted);font-size:12px">${c[0]}</span><span>${c[1]}</span><span class="cad ${CADP[c[2]]}">${c[2]}</span></div>`).join("");
const LOG=[["2026-09-05","周频","原油","库存连降 + 近月升水走阔","真实紧缺","+9.4%","命中"],["2026-09-02","月频","中国 PMI","新订单分项连续两月回升","增长企稳","+1.2pt","命中"],["2026-08-22","周频","铜","投机净多 > 90% 分位","资金推动，回撤风险","−3.1%","命中"],["2026-08-14","日频","TTF","霍尔木兹通行量 −30%","物流冲击","+18.6%","命中"],["2026-07-30","日频","碳酸锂","价格急涨但期限结构平坦","资金推动","+0.8%","不明确"],["2026-07-11","周频","铁矿石","港口连续累库","需求走弱","+2.2%","未命中"],["2026-06-27","日频","黄金","实际利率走高、金价不跌","官方买盘主导","+4.7%","命中"]];
document.getElementById("log").innerHTML=LOG.map(l=>`<tr><td class="num" style="text-align:left">${l[0]}</td><td><span class="cad ${CADP[l[1]]}">${l[1]}</span></td><td>${l[2]}</td><td>${l[3]}</td><td>${l[4]}</td><td class="num ${l[5].startsWith("+")?"up":"down"}">${l[5]}</td><td><span class="pill ${l[6]==="命中"?"p-ok":l[6]==="未命中"?"p-crit":"p-calm"}">${l[6]}</span></td></tr>`).join("")+`<tr><td colspan="7" style="color:var(--faint);font-size:12px">近 6 个月 21 次触发：命中 14，未命中 4，不明确 3。命中率最低的是「需求走弱」规则，下一版加入钢厂开工率作为确认条件。</td></tr>`;

// 详情抽屉
let lastFocus=null;
function openD(id){const c=C.find(x=>x.id===id);if(!c)return;lastFocus=document.activeElement;const d=document.getElementById("drawer");
 const s=c.s.slice(-RANGE);const mx=Math.max(...s),mn=Math.min(...s);
 document.getElementById("din").innerHTML=`<div style="display:flex;justify-content:space-between;align-items:flex-start;gap:10px"><div><div style="font-size:11px;color:var(--faint);letter-spacing:.1em">${c.g} · ${c.u}</div><h2 id="dtitle" style="font-size:22px">${c.name}</h2></div><button class="x" id="dx">关闭</button></div>
 <div style="display:flex;flex-wrap:wrap;gap:14px;align-items:baseline"><span class="num" style="font-size:30px;font-weight:600">${fmt(c.end)}</span>${["d1","w1","m1","y1"].map((k,i)=>`<span class="num ${cls(c[k])}">${["1日","1周","1月","1年"][i]} ${pct(c[k])}</span>`).join("")}${c.reg?`<span class="pill ${REGCLS[c.reg]}">${c.reg}</span>`:""}</div>
 ${spark(s,600,260,{cls:"big",grid:true,sw:1.8,r:3.2})}
 <div class="dgrid"><div class="panel"><div style="font-size:12px;color:var(--faint)"><span class="cad cad-d">日</span> 区间高 / 低</div><div class="num" style="font-weight:600">${fmt(mx)} / ${fmt(mn)}</div></div>
 <div class="panel"><div style="font-size:12px;color:var(--faint)"><span class="cad cad-d">日</span> 期限结构</div><div style="font-weight:600">${c.curve==="升水"?"近月升水：现货偏紧":c.curve==="贴水"?"远月升水：供应宽松":c.curve}</div></div>
 <div class="panel"><div style="font-size:12px;color:var(--faint)"><span class="cad cad-w">周</span> 投机净多两年分位</div>${gauge(c.cot)}</div>
 <div class="panel"><div style="font-size:12px;color:var(--faint)"><span class="cad cad-w">周</span> 库存 vs 5 年同期</div><div class="num" style="font-weight:600">${c.inv==null?"—":c.inv+"% 分位"}</div></div></div>
 ${c.read?`<div class="panel" style="font-size:13.5px">${c.read}</div>`:'<div style="color:var(--faint);font-size:13px">非重点品种，只展示价格与持仓。</div>'}
 <div style="font-size:12px;color:var(--faint)">相关新闻：${NEWS.filter(n=>n[4].some(t=>c.name.includes(t)||t.includes(c.name.slice(0,2)))).map(n=>n[2]).join("；")||"暂无"}</div>
 <div style="font-size:12px;color:var(--faint)">示例数据。真实版此处还会展示：近 12 个合约的期限结构曲线、库存季节性对比图、CFTC 持仓历史。</div>`;
 d.hidden=false;document.getElementById("dx").focus();document.getElementById("dx").onclick=closeD;}
function closeD(){document.getElementById("drawer").hidden=true;if(lastFocus)lastFocus.focus();}
document.getElementById("drawer").addEventListener("click",e=>{if(e.target.id==="drawer")closeD()});
document.addEventListener("keydown",e=>{if(e.key==="Escape"&&!document.getElementById("drawer").hidden)closeD()});


// 经济周期四象限
const QP={us:[[.55,.95],[.5,.9],[.42,.86],[.35,.8],[.3,.74],[.22,.7],[.15,.64],[.08,.6],[0,.56],[-.05,.52],[-.1,.5],[-.12,.47],[-.15,.45]],
          cn:[[-.95,-.9],[-.92,-.88],[-.86,-.85],[-.8,-.82],[-.72,-.8],[-.66,-.78],[-.58,-.74],[-.52,-.72],[-.46,-.69],[-.4,-.66],[-.36,-.64],[-.32,-.62],[-.3,-.6]]};
function renderQuad(){const W=520,H=440,cx=W/2,cy=H/2,R=190;const X=v=>cx+v*R,Y=v=>cy-v*R;
 const qbg=[["过热","增长强 · 通胀高",css("--up-soft"),X(.5),Y(.5)],["滞胀","增长弱 · 通胀高",css("--warn-soft"),X(-.5),Y(.5)],["衰退 / 通缩","增长弱 · 通胀低",css("--calm-soft"),X(-.5),Y(-.5)],["复苏","增长强 · 通胀低",css("--down-soft"),X(.5),Y(-.5)]];
 let g=`<rect x="${cx}" y="${cy-R}" width="${R}" height="${R}" fill="${qbg[0][2]}"/><rect x="${cx-R}" y="${cy-R}" width="${R}" height="${R}" fill="${qbg[1][2]}"/><rect x="${cx-R}" y="${cy}" width="${R}" height="${R}" fill="${qbg[2][2]}"/><rect x="${cx}" y="${cy}" width="${R}" height="${R}" fill="${qbg[3][2]}"/>`;
 g+=`<line x1="${cx-R}" x2="${cx+R}" y1="${cy}" y2="${cy}" stroke="${css("--faint")}" stroke-width="1"/><line x1="${cx}" x2="${cx}" y1="${cy-R}" y2="${cy+R}" stroke="${css("--faint")}" stroke-width="1"/>`;
 const corners=[[X(.96),Y(.9),"end"],[X(-.96),Y(.9),"start"],[X(-.96),Y(-.8),"start"],[X(.96),Y(-.8),"end"]];
 qbg.forEach((q,i)=>{const [x,y,an]=corners[i];g+=`<text x="${x}" y="${y}" text-anchor="${an}" font-size="15" font-weight="700" fill="${css("--ink")}" fill-opacity=".55" font-family="Noto Sans SC,sans-serif">${q[0]}</text><text x="${x}" y="${y+17}" text-anchor="${an}" font-size="11" fill="${css("--muted")}" font-family="Noto Sans SC,sans-serif">${q[1]}</text>`});
 g+=`<text x="${cx+R}" y="${cy+R+22}" text-anchor="end" font-size="11.5" fill="${css("--muted")}" font-family="Noto Sans SC,sans-serif">增长更强 →</text><text x="${cx-R}" y="${cy+R+22}" font-size="11.5" fill="${css("--muted")}" font-family="Noto Sans SC,sans-serif">← 增长更弱</text><text x="${cx+6}" y="${cy-R-8}" font-size="11.5" fill="${css("--muted")}" font-family="Noto Sans SC,sans-serif">↑ 通胀更高</text>`;
 [["us","美国","--accent"],["cn","中国","--calm"]].forEach(([k,n,c])=>{const col=css(c);const p=QP[k];g+=`<path d="M${p.map(q=>X(q[0]).toFixed(1)+","+Y(q[1]).toFixed(1)).join("L")}" fill="none" stroke="${col}" stroke-width="2" stroke-dasharray="1 0" stroke-opacity=".8"/>`;p.forEach((q,i)=>{if(i<p.length-1)g+=`<circle cx="${X(q[0]).toFixed(1)}" cy="${Y(q[1]).toFixed(1)}" r="2.2" fill="${col}" fill-opacity="${.25+.6*i/p.length}"/>`});const e=p.at(-1),s0=p[0];g+=`<circle cx="${X(s0[0]).toFixed(1)}" cy="${Y(s0[1]).toFixed(1)}" r="4" fill="none" stroke="${col}" stroke-width="1.5"/><text x="${(X(s0[0])+8).toFixed(1)}" y="${(Y(s0[1])+4).toFixed(1)}" font-size="11" fill="${css("--muted")}" font-family="Noto Sans SC,sans-serif">一年前</text><circle cx="${X(e[0]).toFixed(1)}" cy="${Y(e[1]).toFixed(1)}" r="8" fill="${col}" stroke="${css("--panel")}" stroke-width="2"/><text x="${(X(e[0])+12).toFixed(1)}" y="${(Y(e[1])+5).toFixed(1)}" font-size="14" font-weight="700" fill="${col}" font-family="Noto Sans SC,sans-serif" paint-order="stroke" stroke="${css("--panel")}" stroke-width="3">${n} · 现在</text>`});
 document.getElementById("quad").innerHTML=g;
 document.getElementById("qlist").innerHTML=`
 <div class="qc"><h3><span class="pill p-acc">美国</span>从过热滑向滞胀边缘</h3><p>一年前增长强、通胀高；现在 PMI 跌破 50、失业率升到 4.4%，增长转弱，但核心通胀仍在 2.9%，没回到 2% 的目标。这一格最难办：降息怕通胀反弹，不降又怕衰退。</p></div>
 <div class="qc"><h3><span class="pill p-calm">中国</span>仍在通缩一格，但在缓慢改善</h3><p>CPI 接近 0、PPI 为负，通胀明显低于目标；增长略弱于潜在水平。过去一年两个维度都在往右上挪：PMI 回到 49.8，PPI 降幅从 −2.8% 收窄到 −1.6%。</p></div>
 <div class="qc"><h3>四格各意味着什么</h3><p><b>复苏</b>：增长回升、通胀仍低，央行通常维持宽松。<b>过热</b>：增长和通胀都高，央行加息降温。<b>滞胀</b>：增长转弱而通胀不降，政策两难。<b>衰退 / 通缩</b>：增长弱、物价低，央行降息、财政加码。见资料库「通胀应对工具箱」「通胀通缩与再分配」。</p></div>
 <div class="qc"><h3>坐标怎么算</h3><p>横轴：PMI、就业、工业生产相对各自十年均值的标准化得分，取平均。纵轴：核心通胀相对央行目标的偏离（美国对 2%，中国对 3%），同样标准化。每月数据公布后更新一个点。示例数据。</p></div>`;}
// 标签页
const PANES=["daily","weekly","monthly","news","cal"];
function show(p){if(!PANES.includes(p))p="daily";PANES.forEach(x=>{document.getElementById("p-"+x).hidden=x!==p;document.getElementById("t-"+x).setAttribute("aria-selected",x===p)});try{localStorage.setItem("wem-tab",p)}catch(e){}}
document.querySelectorAll(".tab").forEach(t=>t.onclick=()=>{show(t.dataset.p);history.replaceState(null,"","#"+t.dataset.p)});
let start=(location.hash||"").slice(1);if(!PANES.includes(start)){try{start=localStorage.getItem("wem-tab")||"daily"}catch(e){start="daily"}}

function renderAll(){renderQuad();renderMkt();renderHeat();renderMap();renderFreight();renderCards();renderMonthly();renderNews();}
document.querySelectorAll(".seg button").forEach(b=>{b.setAttribute("aria-pressed",+b.dataset.r===RANGE);b.onclick=()=>{RANGE=+b.dataset.r;try{localStorage.setItem("wem-range",RANGE)}catch(e){}document.querySelectorAll(".seg button").forEach(x=>x.setAttribute("aria-pressed",x===b));renderMkt();renderHeat();renderFreight();}});
renderAll();show(start);
matchMedia("(prefers-color-scheme: dark)").addEventListener?.("change",renderAll);
new MutationObserver(renderAll).observe(document.documentElement,{attributes:true,attributeFilter:["data-theme"]});
})();
</script>
