 ["美国","10Y 实际利率","%",1.84,.006,"up"],["美国","2Y−10Y 利差","bp",38,.03,"up"],["美国","隐含年内降息次数","次",1.6,.03,"down"],["美国","高收益债利差","bp",318,.012,"down"],["美国","VIX 波动率","",17.8,.04,"down"],["美国","标普 500","",6420,.008,"up"],["美国","费城半导体指数","",6950,.016,"up"],
 ["中国","10Y 国债收益率","%",1.86,.008,"down"],["中国","DR007 资金利率","%",1.52,.01,"down"],["中国","沪深 300","",4180,.01,"up"],["中国","恒生科技指数","",5620,.015,"up"],["中国","南华商品指数","",2510,.008,"up"],
 ["中美之间","美元/人民币","",7.08,.002,"down"],["中美之间","中美 10Y 利差","bp",-248,.01,"up"],["中美之间","美元指数","",98.7,.003,"down"],
 ["全球","美元/日元","",146.3,.004,"up"],["全球","新兴市场货币指数","",1842,.003,"up"]];
MK.forEach(m=>{m.s=series(Math.abs(m[3]),m[4],m[5]==="up"?.0004:-.0004).map(v=>m[3]<0?-v:v);m.w=(m.s.at(-1)/m.s.at(-6)-1)*100*(m[3]<0?-1:1)});
const MKG=[["美国","全球资产定价的锚：利率、信用、风险偏好、科技股"],["中国","第二大经济体的资金面与资产价格"],["中美之间","两国相对强弱与资本流向"],["全球","其余只留两个：日元套息与新兴市场"]];
function renderMkt(){document.getElementById("mkt").innerHTML=MKG.map(g=>`<div class="mgroup" style="margin-bottom:12px"><h3>${g[0]}<span>${g[1]}</span></h3><div class="macro">${MK.filter(m=>m[0]===g[0]).map(m=>`<button class="mtile" data-info="${m[0]}·${m[1]}" data-val="${fmt(m[3])}" data-unit="${m[2]}" data-cad="日"><span class="hint">?</span><div class="k">${m[1]}</div><div class="v num">${fmt(m[3])}${m[2]?`<small style="font-size:12px;color:var(--faint)"> ${m[2]}</small>`:""}</div><div class="d num ${cls(m.w)}">1 周 ${pct(m.w)}</div>${spark(m.s.slice(-RANGE),180,38,{col:css("--accent"),r:2})}${prow((INFO[m[0]+"·"+m[1]]||[])[0])}</button>`).join("")}</div></div>`).join("");bindInfo(document.getElementById("mkt"));}

// 日频：热力表
let FILTER="all",SORT={k:null,dir:-1};
function heatColor(v,scale){const a=Math.min(Math.abs(v)/scale,1);const base=v>=0?css("--up"):css("--down");return `color-mix(in srgb,${base} ${Math.round(a*38)}%,transparent)`;}
function curvePill(c){return c==="升水"?'<span class="pill p-crit">近月升水</span>':c==="贴水"?'<span class="pill p-ok">远月升水</span>':'<span class="pill p-calm">'+c+'</span>';}
function renderHeat(){let rows=C.filter(c=>FILTER==="all"||c.g===FILTER);
 if(SORT.k){rows=rows.slice().sort((a,b)=>{const x=a[SORT.k],y=b[SORT.k];if(SORT.k==="name"||SORT.k==="curve")return SORT.dir*String(x).localeCompare(String(y),"zh");return SORT.dir*((x??-1e9)-(y??-1e9));});}
 const sc={d1:3,w1:6,m1:12,y1:35};
 document.querySelector("#heat tbody").innerHTML=rows.map(c=>`<tr class="row" tabindex="0" data-id="${c.id}"><td class="name">${c.name}<small>${c.u} · ${c.g}</small></td><td class="heat">${fmt(c.end)}</td>${["d1","w1","m1","y1"].map(k=>`<td class="heat" style="background:${heatColor(c[k],sc[k])}">${pct(c[k])}</td>`).join("")}<td>${curvePill(c.curve)}</td><td class="spark">${spark(c.s.slice(-RANGE),110,24,{r:1.8})}</td></tr>`).join("");
 document.querySelectorAll("#heat tr.row").forEach(tr=>{tr.onclick=()=>openD(tr.dataset.id);tr.onkeydown=e=>{if(e.key==="Enter")openD(tr.dataset.id)}});}
document.querySelectorAll("#heat th[data-k]").forEach(th=>th.onclick=()=>{const k=th.dataset.k;SORT.dir=SORT.k===k?-SORT.dir:-1;SORT.k=k;renderHeat();});
document.querySelectorAll("#filters .chip").forEach(b=>b.onclick=()=>{FILTER=b.dataset.g;document.querySelectorAll("#filters .chip").forEach(x=>x.setAttribute("aria-pressed",x===b));renderHeat();});

// 日频：地图、运价、价差
const CK=[["霍尔木兹",565.8,123.8,-38],["曼德",533.5,158.5,-52],["苏伊士",506.2,114.5,-45],["马六甲",678.8,183,3],["巴拿马",226,167.5,-6],["好望角",471,276.5,41],["土耳其海峡",497.5,87.2,-2],["台湾海峡",724.5,128.8,1]];
const ckCol=v=>v<=-25?css("--crit"):v<=-10?css("--warn"):v>=25?css("--accent"):css("--calm");
function renderMap(){
 const lanes=[[[740,112],[724,129],[700,160],[679,183],[640,176],[600,164],[560,150],[534,158],[515,135],[506,114],[480,108],[420,112],[388,100],[395,80],[410,64],[430,58]],[[600,164],[585,140],[566,124]],[[640,176],[560,240],[471,277],[430,230],[395,170],[388,100]],[[226,168],[200,140],[180,124]]];
 document.getElementById("lanes").innerHTML=lanes.map((l,i)=>`<path d="M${l.map(p=>p.join(",")).join("L")}" fill="none" stroke="${i===2?css("--faint"):css("--accent")}" stroke-width="1.6" ${i===2?'stroke-dasharray="5 4"':""} stroke-opacity=".7"/>`).join("");
 document.getElementById("cks").innerHTML=CK.map(c=>{const col=ckCol(c[3]);const r=6+Math.min(Math.abs(c[3]),55)/6;return `<g><circle cx="${c[1]}" cy="${c[2]}" r="${r.toFixed(1)}" fill="${col}" fill-opacity=".22"/><circle cx="${c[1]}" cy="${c[2]}" r="4.5" fill="${col}" stroke="${css("--panel")}" stroke-width="1.2"/><text x="${c[1]+9}" y="${c[2]-7}" font-size="12" font-weight="600" fill="${css("--ink")}" font-family="Noto Sans SC,sans-serif" paint-order="stroke" stroke="${css("--map-sea")}" stroke-width="3">${c[0]} ${c[3]>0?"+":""}${c[3]}%</text></g>`}).join("");
 document.getElementById("cklist").innerHTML=CK.slice().sort((a,b)=>a[3]-b[3]).map(c=>{const col=ckCol(c[3]);const w=Math.min(Math.abs(c[3]),60)/60*50;return `<div class="ck"><span>${c[0]}</span><div class="barbg"><em></em><b style="background:${col};${c[3]<0?`right:50%;width:${w}%`:`left:50%;width:${w}%`}"></b></div><span class="num" style="text-align:right;color:${col}">${c[3]>0?"+":""}${c[3]}%</span></div>`}).join("");}
const FR=[["波罗的海干散货 BDI","--calm",series(118,.02,.0006)],["中东—中国 VLCC 运价","--crit",series(187,.03,.0024)]];
function renderFreight(){const n=RANGE,w=400,h=150,pad=24;const all=FR.map(f=>{const a=f[2].slice(-n);const b=a[0];return a.map(v=>v/b*100)});const mn=Math.min(...all.flat()),mx=Math.max(...all.flat());
 let g="";[mn,100,mx].forEach(v=>{const y=pad/2+(h-pad)*(1-(v-mn)/(mx-mn));g+=`<line x1="30" x2="${w}" y1="${y.toFixed(1)}" y2="${y.toFixed(1)}" stroke="${css("--line")}" stroke-width=".7"/><text x="0" y="${(y+4).toFixed(1)}" font-size="10" fill="${css("--faint")}" font-family="IBM Plex Mono,monospace">${v.toFixed(0)}</text>`});
 const paths=all.map((a,j)=>{const col=css(FR[j][1]);const pts=a.map((v,i)=>[30+i*(w-34)/(a.length-1),pad/2+(h-pad)*(1-(v-mn)/(mx-mn))]);return `<path d="M${pts.map(p=>p.map(x=>x.toFixed(1)).join(",")).join("L")}" fill="none" stroke="${col}" stroke-width="1.6"/><circle cx="${pts.at(-1)[0].toFixed(1)}" cy="${pts.at(-1)[1].toFixed(1)}" r="2.6" fill="${col}"/>`}).join("");
 document.getElementById("freight").innerHTML=g+paths;
 document.getElementById("flegend").innerHTML=FR.map((f,j)=>`<span style="--c:var(${f[1]})">${f[0]} <b class="num ${cls(all[j].at(-1)-100)}">${pct(all[j].at(-1)-100)}</b></span>`).join("");}
const SP=[["布伦特 − WTI","3.70 $/桶","+0.9","走阔：大西洋两岸运费上升"],["欧洲 TTF − 美国 HH","14.1 $/MMBtu","+2.6","走阔：欧洲供应偏紧"],["亚洲 JKM − 欧洲 TTF","4.1 $/MMBtu","+1.8","走阔：卡塔尔货源绕行，亚洲抢货"],["沪铜 − 伦铜（含税）","−320 元/吨","−180","进口窗口关闭，国内需求偏弱"],["上海金溢价","+14 $/盎司","+6","国内实物需求旺盛"]];
document.getElementById("spreads").innerHTML=SP.map(s=>`<div class="li"><span>${s[0]}<small>${s[3]}</small></span><span class="num">${s[1]}</span><span class="num ${s[2].startsWith("+")?"up":"down"}">${s[2]}</span></div>`).join("");

// 周频
function curveSvg(cv,w=90,h=26){if(!cv)return "";const mn=Math.min(...cv),mx=Math.max(...cv),r=mx-mn||1;const pts=cv.map((v,i)=>[2+i*(w-4)/(cv.length-1),3+(h-6)*(1-(v-mn)/r)]);return `<svg viewBox="0 0 ${w} ${h}" preserveAspectRatio="none"><path d="M${pts.map(p=>p.map(n=>n.toFixed(1)).join(",")).join("L")}" fill="none" stroke="${css("--ink")}" stroke-width="1.3" vector-effect="non-scaling-stroke"/>${pts.map((p,i)=>i%3===0?`<circle cx="${p[0].toFixed(1)}" cy="${p[1].toFixed(1)}" r="1.6" fill="${css("--ink")}"/>`:"").join("")}</svg>`;}
function gauge(p){return p==null?'<div class="v" style="color:var(--faint)">无数据</div>':`<div class="v num">${p}% 分位</div><div class="gauge"><i style="left:calc(${p}% - 1px)"></i></div>`;}
function renderCards(){document.getElementById("cards").innerHTML=C.filter(c=>c.key).map(c=>`<button class="card" data-id="${c.id}">
 <div class="hd"><div><div class="nm">${c.name}</div><div class="unit">${c.u} · 价格截至上周五</div></div><span class="pill ${REGCLS[c.reg]}">${c.reg}</span></div>
 <div style="display:flex;align-items:baseline;gap:10px"><span class="px num">${fmt(c.end)}</span><span class="chg num ${cls(c.w1)}">1周 ${pct(c.w1)}</span><span class="chg num ${cls(c.m1)}">1月 ${pct(c.m1)}</span></div>
 ${spark(c.s.slice(-130),300,64,{cls:"main",grid:true,sw:1.6})}
 <div class="facts"><div class="fact"><span class="k">期限结构 M1→M12</span>${curveSvg(c.cv)}</div>
 <div class="fact"><span class="k">库存 vs 5 年同期</span>${c.inv==null?'<div class="v" style="color:var(--faint)">不适用</div>':`<div class="v num">${c.inv}% 分位</div><div class="gauge"><i style="left:calc(${c.inv}% - 1px)"></i></div>`}</div>
 <div class="fact"><span class="k">投机净多（两年）</span>${gauge(c.cot)}</div></div>
 <div class="read">${c.read}</div></button>`).join("");
 document.querySelectorAll(".card").forEach(b=>b.onclick=()=>openD(b.dataset.id));}
const COT=[["原油",62,5],["欧洲天然气",55,-3],["铜",94,3],["铝",66,1],["黄金",71,-2],["白银",79,4],["大豆",35,-6],["小麦",18,-2],["玉米",27,2]];
document.getElementById("cot").innerHTML=COT.map(c=>`<tr><td style="text-align:left">${c[0]}</td><td class="num"><div style="display:flex;align-items:center;gap:8px;justify-content:flex-end"><span>${c[1]}%</span><span class="gauge" style="width:80px;display:inline-block;margin:0"><i style="left:calc(${c[1]}% - 1px)"></i></span></div></td><td class="num ${cls(c[2])}">${c[2]>0?"+":""}${c[2]}</td><td>${c[1]>=85?'<span class="pill p-warn">拥挤</span>':c[1]<=15?'<span class="pill p-ok">极度看空</span>':'<span class="pill p-calm">中性</span>'}</td></tr>`).join("");
const INV=[["EIA 美国商业原油","4.12 亿桶","−310 万",18],["EIA 汽油","2.21 亿桶","+80 万",44],["EIA 馏分油","1.15 亿桶","−140 万",12],["库欣原油","2,280 万桶","−60 万",9],["欧洲天然气库存填充率","86%","+0.6 pct",21],["LME 铜","14.6 万吨","+0.9 万",61],["上期所铜","8.2 万吨","−0.4 万",38],["中国港口铁矿石","1.52 亿吨","+600 万",83]];
document.getElementById("inv").innerHTML=INV.map(r=>`<tr><td style="text-align:left">${r[0]}</td><td class="num">${r[1]}</td><td class="num ${r[2].startsWith("+")?"up":"down"}">${r[2]}</td><td class="num"><div style="display:flex;align-items:center;gap:8px;justify-content:flex-end"><span class="${r[3]<=20?"up":r[3]>=80?"down":""}">${r[3]}%</span><span class="gauge" style="width:70px;display:inline-block;margin:0"><i style="left:calc(${r[3]}% - 1px)"></i></span></div></td></tr>`).join("");
const WM=[["美国初请失业金","23.4","万人","22.1","周四发布","截至 09-27",.5],["美联储资产负债表","6.41","万亿美元","6.43","周四 H.4.1","截至 10-01",.02],["上海出口集装箱运价 SCFI","2,140","点","2,015","每周五","截至 10-03",60],["芝加哥联储金融条件指数","−0.42","","−0.45","每周三","截至 09-26",.03]];
document.getElementById("weeklyMisc").innerHTML=WM.map(m=>{const v=parseFloat(m[1].replace("−","-").replace(/,/g,""));const pv=parseFloat(m[3].replace("−","-").replace(/,/g,""));const s=mseries(v,pv,26,m[6]);return `<button class="mt" data-info="周·${m[0]}" data-val="${m[1]}" data-unit="${m[2]}" data-cad="周"><span class="hint">?</span><div class="k">${m[0]}</div><div class="row1"><span class="v num">${m[1]}</span><span class="pv">${m[2]} · 前值 ${m[3]}</span></div>${spark(s,200,34,{col:css("--calm"),r:2})}${prow((INFO["周·"+m[0]]||[])[0])}<div class="when"><span>${m[5]}</span><span>${m[4]}</span></div></button>`}).join("");
bindInfo(document.getElementById("weeklyMisc"));

