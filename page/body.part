function surp(v,c){if(c==="")return "";const x=parseFloat(v.replace("−","-").replace(/,/g,"")),y=parseFloat(c.replace("−","-").replace(/,/g,""));const d=x-y;if(Math.abs(d)<1e-9)return `<span class="surp" style="color:var(--faint)">符合预期</span>`;return `<span class="surp ${d>0?"up":"down"}">${d>0?"高于":"低于"}预期 ${c}</span>`;}
function renderMonthly(){document.getElementById("monthly").innerHTML=MG.map(g=>`<section class="panel mgroup"><h3>${g[0]}<span>${g[1]}</span></h3><div class="mtiles">${g[2].map(t=>{const v=parseFloat(t[1].replace("−","-").replace(/,/g,"")),pv=parseFloat(t[3].replace("−","-").replace(/,/g,""));const s=mseries(v,pv,24,Math.max(Math.abs(v-pv),Math.abs(v)*.04,.2));const key=g[0]+"·"+t[0];return `<button class="mt" data-info="${key}" data-val="${t[1]}" data-unit="${t[2]}" data-cad="月"><span class="hint">?</span><div class="k">${t[0]}</div><div class="row1"><span class="v num">${t[1]}</span><span class="pv">${t[2]?t[2]+" · ":""}前值 ${t[3]}</span></div>${surp(t[1],t[4])}${t[8]==="bars"?bars(s,200,34,t[7]):spark(s,200,34,{col:css("--ok"),r:2})}${prow((INFO[key]||[])[0])}<div class="when"><span>数据：${t[5]}</span><span>下次 ${t[6]}</span></div></button>`}).join("")}</div></section>`).join("");bindInfo(document.getElementById("monthly"));}

