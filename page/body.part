 ["10-06 06:40","地缘","伊朗称将在霍尔木兹海峡实施「临时检查」，两艘油轮改道","海峡通行量连续第五天低于均值；保险商上调战争险费率。",["原油","TTF","JKM","VLCC 运价"],["2026 伊朗战争","全球交通枢纽"]],
 ["10-05 21:15","央行","美联储官员：通胀回落进程放缓，年内降息空间有限","市场隐含年内降息次数从 2.1 次降至 1.6 次，2 年期美债收益率上行 9 个基点。",["隐含降息次数","2Y−10Y 利差","美元指数"],["货币创造与加息传导"]],
 ["10-05 14:30","贸易","中美贸易休战到期前首轮磋商结束，未就稀土出口许可延期达成一致","10 月出口管制措施的暂停期将于 11 月到期；稀土相关企业股价波动。",["稀土","费城半导体指数"],["国际经济冲突","资源与外部冲击"]],
 ["10-04 09:00","产业","智利最大铜矿罢工进入第二周","约占全球铜供应 2%；LME 铜价创新高，但交易所库存未降。",["铜","CFTC 铜持仓"],["全球产业链窄点"]],
 ["10-03 18:20","央行","中国人民银行下调存款准备金率 0.25 个百分点","释放长期流动性约 5000 亿元；配合地方专项债加快发行。",["M1−M2 剪刀差","沪深 300","美元/人民币"],["宏观稳定"]],
 ["10-02 11:05","产业","OPEC+ 宣布 11 月小幅增产，低于市场预期","实际增量主要来自沙特与阿联酋，但两国出口受海峡局势限制。",["原油","布伦特近远月价差"],["全球资源分布"]],
 ["10-01 16:45","贸易","欧盟对进口电动车反补贴税复审启动","涉及中国车企与部分欧洲品牌在华工厂；锂价反应平淡。",["碳酸锂","中国出口"],["增长与结构"]]];
let NC="all";
