<title>世界经济监控台</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700;800&family=IBM+Plex+Mono:wght@400;500;600&family=Noto+Sans+SC:wght@400;500;700&display=swap">
<style>
/* 布局：交易台式的分区面板。结论条 → 宏观层 → 商品层（热力表 + 品种卡片）→ 通道（地图 + 运价）→ 价差 → 信号日志 → 日程 */
:root{
  --bg:#EEF0EC; --panel:#FBFCFA; --ink:#17201C; --muted:#5D6A64; --faint:#8A958F; --line:#D8DDD7;
  --accent:#A9561F; --accent-soft:#F3E3D6;
  --up:#C4352A; --down:#23845A; --warn:#B9800E; --crit:#C4352A; --ok:#23845A; --calm:#6B7C88;
  --up-soft:#F6DCD8; --down-soft:#D7EEE3; --warn-soft:#F5E7C6; --calm-soft:#E1E7EB;
  --map-land:#DCE1DB; --map-sea:#F6F8F5;
  --f-display:"Archivo","Noto Sans SC",system-ui,sans-serif;
  --f-body:"Noto Sans SC","Archivo",system-ui,sans-serif;
  --f-num:"IBM Plex Mono",ui-monospace,Menlo,monospace;
}
@media (prefers-color-scheme: dark){:root:not([data-theme="light"]){
  --bg:#101513; --panel:#171D1A; --ink:#E4E9E5; --muted:#9AA7A1; --faint:#6E7B75; --line:#2A332F;
  --accent:#E08A4E; --accent-soft:#3A2A1F;
  --up:#F0675A; --down:#4FC08A; --warn:#E3AD3B; --crit:#F0675A; --ok:#4FC08A; --calm:#93A6B3;
  --up-soft:#3D2220; --down-soft:#173327; --warn-soft:#3A2F15; --calm-soft:#232D33;
  --map-land:#2A332F; --map-sea:#141A17; color-scheme:dark}}
:root[data-theme="dark"]{
  --bg:#101513; --panel:#171D1A; --ink:#E4E9E5; --muted:#9AA7A1; --faint:#6E7B75; --line:#2A332F;
  --accent:#E08A4E; --accent-soft:#3A2A1F;
  --up:#F0675A; --down:#4FC08A; --warn:#E3AD3B; --crit:#F0675A; --ok:#4FC08A; --calm:#93A6B3;
  --up-soft:#3D2220; --down-soft:#173327; --warn-soft:#3A2F15; --calm-soft:#232D33;
  --map-land:#2A332F; --map-sea:#141A17; color-scheme:dark}
*{box-sizing:border-box}
body{background:var(--bg);color:var(--ink);font-family:var(--f-body);font-size:14px;line-height:1.55;margin:0}
.wrap{max-width:1260px;margin:0 auto;padding-inline:20px;padding-block:20px 48px;display:flex;flex-direction:column;gap:18px}
.num{font-family:var(--f-num);font-variant-numeric:tabular-nums}
h1,h2,h3{font-family:var(--f-display);margin:0;text-wrap:balance}
.top{display:flex;flex-wrap:wrap;align-items:flex-end;justify-content:space-between;gap:12px;border-bottom:2px solid var(--ink);padding-bottom:12px}
.top h1{font-size:30px;font-weight:800;letter-spacing:-.01em}
.top .sub{color:var(--muted);font-size:13px;margin-top:2px}
.meta{display:flex;flex-wrap:wrap;gap:8px;align-items:center}
.badge{font-size:12px;font-weight:600;padding:3px 9px;border-radius:999px;background:var(--accent-soft);color:var(--accent);letter-spacing:.04em}
.stamp{font-size:12px;color:var(--muted)}
.seg{display:inline-flex;border:1px solid var(--line);border-radius:8px;overflow:hidden;background:var(--panel)}
.seg button{all:unset;cursor:pointer;padding:5px 11px;font-size:12px;font-family:var(--f-num);color:var(--muted)}
.seg button[aria-pressed="true"]{background:var(--ink);color:var(--panel)}
.seg button:focus-visible{outline:2px solid var(--accent);outline-offset:-2px}
.panel{background:var(--panel);border:1px solid var(--line);border-radius:10px;padding:16px 18px;min-width:0}
.ph{display:flex;flex-wrap:wrap;justify-content:space-between;align-items:baseline;gap:8px;margin-bottom:12px}
.ph h2{font-size:17px;font-weight:700}
.ph .eyebrow{font-size:11px;letter-spacing:.12em;color:var(--faint);text-transform:uppercase;font-family:var(--f-num)}
.ph .note{font-size:12px;color:var(--muted)}
/* 结论条 */
.verdict{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:10px}
.sig{display:grid;grid-template-columns:6px 1fr;gap:12px;background:var(--panel);border:1px solid var(--line);border-radius:10px;padding:12px 14px 12px 0;overflow:hidden}
.sig .bar{border-radius:0 4px 4px 0}
.sig h3{font-size:14px;font-weight:700;display:flex;gap:8px;align-items:center;flex-wrap:wrap}
.sig p{margin:4px 0 0;font-size:13px;color:var(--muted)}
.pill{font-size:11px;font-weight:700;padding:2px 8px;border-radius:999px;letter-spacing:.03em;white-space:nowrap}
.p-crit{background:var(--up-soft);color:var(--crit)} .p-warn{background:var(--warn-soft);color:var(--warn)}
.p-ok{background:var(--down-soft);color:var(--ok)} .p-calm{background:var(--calm-soft);color:var(--calm)}
.p-acc{background:var(--accent-soft);color:var(--accent)}
/* 宏观六宫格 */
.macro{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:10px}
.mtile{border:1px solid var(--line);border-radius:8px;padding:10px 12px;display:flex;flex-direction:column;gap:2px;min-width:0}
.mtile .k{font-size:12px;color:var(--muted)}
.mtile .v{font-size:22px;font-weight:600}
.mtile .d{font-size:12px}
.mtile svg{width:100%;height:38px;display:block;margin-top:4px}
.up{color:var(--up)} .down{color:var(--down)}
/* 热力表 */
.filters{display:flex;flex-wrap:wrap;gap:6px}
.chip{all:unset;cursor:pointer;font-size:12px;padding:4px 10px;border:1px solid var(--line);border-radius:999px;color:var(--muted)}
.chip[aria-pressed="true"]{border-color:var(--ink);color:var(--ink);font-weight:600}
.chip:focus-visible{outline:2px solid var(--accent)}
.tablebox{overflow-x:auto}
table{border-collapse:collapse;width:100%;min-width:720px}
th,td{padding:7px 8px;text-align:right;border-bottom:1px solid var(--line);white-space:nowrap}
th{font-size:11px;color:var(--faint);font-weight:600;letter-spacing:.06em;cursor:pointer;user-select:none}
th:first-child,td:first-child{text-align:left}
td.name{font-weight:600}
td.name small{display:block;font-weight:400;color:var(--faint);font-size:11px}
td.heat{font-family:var(--f-num);font-variant-numeric:tabular-nums;font-size:13px}
td.spark svg{width:110px;height:24px;display:block;margin-left:auto}
tr.row{cursor:pointer} tr.row:hover td{background:color-mix(in srgb,var(--accent) 6%,transparent)}
/* 品种卡片 */
.cards{display:grid;grid-template-columns:repeat(auto-fill,minmax(290px,1fr));gap:12px}
.card{border:1px solid var(--line);border-radius:10px;padding:14px;display:flex;flex-direction:column;gap:10px;cursor:pointer;background:var(--panel);min-width:0;text-align:left;font:inherit;color:inherit}
.card:hover{border-color:var(--faint)} .card:focus-visible{outline:2px solid var(--accent)}
.card .hd{display:flex;justify-content:space-between;align-items:flex-start;gap:8px}
.card .nm{font-family:var(--f-display);font-weight:700;font-size:16px}
.card .unit{font-size:11px;color:var(--faint)}
.card .px{font-size:22px;font-weight:600;line-height:1.1}
.card .chg{font-size:12px}
.card svg.main{width:100%;height:64px;display:block}
.facts{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}
.fact{display:flex;flex-direction:column;gap:3px;min-width:0}
.fact .k{font-size:11px;color:var(--faint)}
.fact .v{font-size:12px;font-weight:600}
.fact svg{width:100%;height:26px;display:block}
.gauge{height:6px;border-radius:3px;background:var(--line);position:relative;margin-top:4px}
.gauge i{position:absolute;top:-3px;width:3px;height:12px;border-radius:2px;background:var(--ink)}
.read{font-size:12.5px;color:var(--muted);border-top:1px dashed var(--line);padding-top:8px}
/* 通道 */
.grid2{display:grid;grid-template-columns:minmax(0,1.6fr) minmax(0,1fr);gap:12px}
@media (max-width:900px){.grid2{grid-template-columns:1fr}}
.mapbox svg{width:100%;height:auto;display:block;border-radius:8px}
.cklist{display:flex;flex-direction:column;gap:6px;margin-top:10px}
.ck{display:grid;grid-template-columns:90px 1fr 60px;gap:10px;align-items:center;font-size:12.5px}
.ck .barbg{height:8px;background:var(--line);border-radius:4px;position:relative}
.ck .barbg b{position:absolute;top:0;height:8px;border-radius:4px}
.ck .barbg em{position:absolute;left:50%;top:-3px;width:1px;height:14px;background:var(--faint)}
.freight svg{width:100%;height:150px;display:block}
.legend{display:flex;flex-wrap:wrap;gap:12px;font-size:12px;color:var(--muted)}
.legend span::before{content:"";display:inline-block;width:14px;height:3px;border-radius:2px;margin-right:6px;vertical-align:middle;background:var(--c)}
/* 价差与日程 */
.list{display:flex;flex-direction:column}
.li{display:grid;grid-template-columns:1fr auto auto;gap:12px;padding:8px 0;border-bottom:1px solid var(--line);align-items:center;font-size:13px}
.li:last-child{border-bottom:0}
.li small{display:block;color:var(--faint);font-size:11.5px}
.cal .li{grid-template-columns:86px 1fr auto}
/* 信号日志 */
.log td{text-align:left;white-space:normal;font-size:13px}
.log td.num,.log th.num{text-align:right}
/* 详情抽屉 */
.drawer[hidden]{display:none}
.drawer{position:fixed;inset:0;display:flex;justify-content:flex-end;background:color-mix(in srgb,var(--ink) 30%,transparent);z-index:10}
.drawer .in{width:min(640px,100%);height:100%;background:var(--panel);padding:20px 22px calc(20px + env(safe-area-inset-bottom,0px));overflow-y:auto;display:flex;flex-direction:column;gap:14px;border-left:1px solid var(--line)}
.drawer .x{all:unset;cursor:pointer;font-size:13px;color:var(--muted);padding:4px 10px;border:1px solid var(--line);border-radius:6px}
.drawer svg.big{width:100%;height:260px;display:block}
.dgrid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}
.foot{font-size:12px;color:var(--faint);display:flex;flex-direction:column;gap:6px}
details summary{cursor:pointer;font-weight:600;color:var(--muted)}
@media (prefers-reduced-motion:no-preference){.card,.chip,.seg button{transition:border-color .15s,background .15s}}
@media (max-width:520px){.top h1{font-size:24px}.facts{grid-template-columns:1fr 1fr 1fr}.ck{grid-template-columns:72px 1fr 52px}}

